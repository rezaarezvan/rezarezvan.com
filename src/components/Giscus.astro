<section class="giscus-section">
  <script is:inline>
    ;(() => {
      const ORIGIN = 'https://giscus.app'
      const mount = document.currentScript.parentElement

      const theme = () =>
        document.documentElement.getAttribute('data-theme') === 'dark'
          ? 'gruvbox_dark'
          : 'gruvbox_light'

      const script = document.createElement('script')
      script.src = `${ORIGIN}/client.js`
      script.async = true
      script.crossOrigin = 'anonymous'
      Object.assign(script.dataset, {
        repo: 'rezaarezvan/rezarezvan.com',
        repoId: 'R_kgDOHvQr3w',
        category: 'General',
        categoryId: 'DIC_kwDOHvQr384CiWVC',
        mapping: 'og:title',
        theme: theme(),
        lang: 'en',
        loading: 'lazy',
      })
      mount.appendChild(script)

      let sent = theme()
      let ready = false

      function sync() {
        if (!ready || theme() === sent) return
        sent = theme()
        mount
          .querySelector('iframe.giscus-frame')
          ?.contentWindow?.postMessage(
            { giscus: { setConfig: { theme: sent } } },
            ORIGIN,
          )
      }

      window.addEventListener('message', (event) => {
        if (event.origin !== ORIGIN) return
        ready = true
        sync()
      })

      new MutationObserver(sync).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      })
    })()
  </script>
</section>

<style>
  .giscus-section {
    margin-inline: auto;
    margin-block-start: var(--space-xl);
  }
</style>
