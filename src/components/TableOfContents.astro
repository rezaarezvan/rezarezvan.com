---
import Icon from '@/components/Icon.astro'
import InlineMathText from '@/components/InlineMathText.astro'
import { getTocLabels } from '@/lib/toc-utils'
import { cn, getHeadingMargin } from '@/lib/utils'
import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
  source?: string
  title: string
  readingTime?: string
}

const { headings, source = '', title, readingTime } = Astro.props
const labels = source
  ? getTocLabels(source, headings)
  : headings.map(({ text }) => text)
const shallowestHeading = Math.min(...headings.map(({ depth }) => depth))
---

{headings.length > 0 && (
  <page-toc id="page-toc">
    <details class="toc-mobile">
      <summary class="toc-mobile-summary">
        <svg class="toc-progress" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="10" class="toc-progress-track" />
          <circle cx="12" cy="12" r="10" class="toc-progress-value" />
        </svg>
        <span class="toc-current" data-toc-current>Overview</span>
        <Icon name="chevron-down" class="toc-chevron size-4" />
      </summary>
      <nav class="toc-mobile-panel" aria-label="Table of contents">
        <ul class="toc-list">
          {headings.map((heading, index) => (
            <li class={cn('toc-item', getHeadingMargin(heading.depth))}>
              <a
                href={`#${heading.slug}`}
                class="toc-link"
                data-toc-link
                data-heading-id={heading.slug}
              >
                <InlineMathText text={labels[index]} />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>

    <aside class="toc-desktop" aria-label="Table of contents">
      <nav class="toc-outline">
        <a href="#" class="toc-desktop-header" data-toc-top>
          <span class="toc-desktop-title">
            <InlineMathText text={title} />
          </span>
          {readingTime && <span class="toc-desktop-time">{readingTime}</span>}
        </a>

        <ul class="toc-list" data-toc-outline>
          <li class="toc-leading-spacer" data-toc-leading-spacer hidden />
          {headings.map((heading, index) => (
            <li
              class={cn('toc-item', getHeadingMargin(heading.depth))}
              data-toc-item
              data-heading-id={heading.slug}
              data-outline-level={heading.depth - shallowestHeading}
            >
              <a
                href={`#${heading.slug}`}
                class="toc-link"
                data-toc-link
                data-heading-id={heading.slug}
              >
                <InlineMathText text={labels[index]} />
              </a>
            </li>
          ))}
        </ul>

        <span class="toc-rail-track" aria-hidden="true">
          <span class="toc-rail-window" hidden />
        </span>
      </nav>
    </aside>
  </page-toc>
)}

<style>
  page-toc {
    display: block;
    width: 100%;
  }

  .toc-mobile-summary {
    display: flex;
    width: min(100%, var(--measure));
    margin-inline: auto;
    align-items: center;
    padding: var(--space-xs) var(--space-s);
    cursor: pointer;
    list-style: none;
  }

  .toc-mobile-summary::-webkit-details-marker {
    display: none;
  }

  .toc-progress {
    width: 1rem;
    height: 1rem;
    flex: none;
    margin-inline-end: var(--space-2xs);
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    transform: rotate(-90deg);
  }

  .toc-progress-track {
    color: var(--border);
  }

  .toc-progress-value {
    color: var(--muted-foreground);
    stroke-dasharray: 62.832;
    stroke-dashoffset: 62.832;
  }

  .toc-current {
    min-width: 0;
    flex: 1;
    overflow: hidden;
    color: var(--muted-foreground);
    font-size: var(--step--1);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .toc-chevron {
    flex: none;
    margin-inline-start: var(--space-2xs);
    color: var(--muted-foreground);
    transition: transform 0.2s ease;
  }

  details[open] .toc-chevron {
    transform: rotate(180deg);
  }

  .toc-mobile-panel {
    position: absolute;
    z-index: 60;
    inset-block-start: 100%;
    inset-inline: 0;
    width: min(100%, var(--measure));
    max-height: min(65dvh, 32rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    margin-inline: auto;
    padding: var(--space-xs) var(--space-s) var(--space-s);
    border: 1px solid var(--border);
    border-block-start: 0;
    background: var(--background);
    box-shadow: 0 1rem 2rem
      color-mix(in oklab, var(--foreground) 9%, transparent);
    scrollbar-width: thin;
  }

  .toc-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    list-style: none;
  }

  .toc-item {
    color: color-mix(in oklab, var(--foreground) 60%, transparent);
    font-size: var(--step--1);
  }

  .toc-link {
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;
  }

  .toc-link:hover {
    text-decoration-color: currentColor;
  }

  .toc-link[aria-current="location"] {
    color: var(--foreground);
  }

  .toc-desktop {
    display: none;
  }

  @media (min-width: 80rem) {
    page-toc {
      position: fixed;
      z-index: 40;
      top: 5rem;
      inset-inline-start: max(
        1rem,
        calc(50vw - var(--content-width) / 2 - 21.375rem)
      );
      inset-inline-end: calc(50vw + var(--content-width) / 2 + 3.125rem);
      width: auto;
      height: calc(100vh - 7rem);
      pointer-events: none;
    }

    .toc-mobile {
      display: none;
    }

    .toc-desktop,
    .toc-outline {
      width: 100%;
      height: 100%;
      min-height: 0;
    }

    .toc-desktop {
      display: block;
      box-sizing: border-box;
      overflow: hidden;
      padding-block: 0.75rem;
      pointer-events: auto;
    }

    .toc-outline {
      position: relative;
      display: flex;
      box-sizing: border-box;
      flex-direction: column;
      padding-inline-end: 1.75rem;
    }

    .toc-desktop-header {
      display: block;
      flex: none;
      padding: 0.15rem var(--space-s) 0.8rem 0;
      color: color-mix(in oklab, var(--foreground) 58%, transparent);
      text-decoration: none;
      transition: color 0.12s ease;
    }

    .toc-desktop-header:is(:hover, :focus-visible),
    .toc-desktop-header[aria-current="location"] {
      color: var(--foreground);
    }

    .toc-desktop-title {
      display: -webkit-box;
      overflow: hidden;
      font-size: 0.9rem;
      font-variant-caps: small-caps;
      line-height: 1.05;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .toc-desktop-header[aria-current="location"] .toc-desktop-title {
      font-weight: var(--font-weight-medium);
    }

    .toc-desktop-time {
      display: block;
      margin-block-start: 0.35rem;
      color: color-mix(in oklab, currentColor 72%, transparent);
      font-size: 0.72rem;
      line-height: 1;
    }

    .toc-desktop .toc-list {
      position: relative;
      z-index: 1;
      height: 100%;
      min-height: 0;
      flex: 1;
      gap: 0;
    }

    .toc-leading-spacer {
      min-height: 0;
      flex: var(--toc-leading-scale, 0) 1 0%;
    }

    .toc-leading-spacer[hidden] {
      display: none;
    }

    .toc-desktop .toc-item {
      position: relative;
      display: flex;
      flex: var(--toc-section-scale, 1) 1 0%;
      align-items: flex-start;
      margin-inline-start: 0;
    }

    .toc-desktop .toc-item[data-outline-level="1"] {
      padding-inline-start: 0.75rem;
    }

    .toc-desktop .toc-item[data-outline-level="2"] {
      padding-inline-start: 1.5rem;
    }

    .toc-desktop .toc-item[data-outline-level="3"] {
      padding-inline-start: 2.25rem;
    }

    .toc-desktop .toc-item[data-outline-level="4"],
    .toc-desktop .toc-item[data-outline-level="5"] {
      padding-inline-start: 3rem;
    }

    .toc-desktop .toc-link {
      display: block;
      width: 100%;
      min-width: 0;
      padding: 0.1rem var(--space-xs) 0.1rem 0;
      color: color-mix(in oklab, var(--foreground) 58%, transparent);
      font-size: var(--step--1);
      line-height: 1.05;
      overflow-wrap: anywhere;
      transition: color 0.12s ease;
    }

    .toc-desktop .toc-item::before,
    .toc-desktop .toc-item::after {
      position: absolute;
      inset-block-start: 0.62rem;
      border-radius: var(--radius-full);
      content: "";
      transform: translateY(-50%);
    }

    .toc-desktop .toc-item::before {
      z-index: 1;
      inset-inline-end: -1.06rem;
      width: 0.34rem;
      height: 0.68rem;
      background-color: var(--background);
    }

    .toc-desktop .toc-item::after {
      z-index: 2;
      inset-inline-end: -0.98rem;
      width: 0.18rem;
      height: 0.18rem;
      background-color: color-mix(in oklab, var(--foreground) 46%, transparent);
    }

    .toc-desktop .toc-link:is(:hover, :focus-visible) {
      color: var(--foreground);
      text-decoration-color: transparent;
    }

    .toc-desktop .toc-link[aria-current="location"] {
      color: var(--foreground);
      font-weight: var(--font-weight-medium);
    }

    .toc-desktop .toc-list[data-dense] .toc-link {
      overflow: hidden;
      padding-block: 0.05rem;
      font-size: 0.72rem;
      line-height: 1;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .toc-desktop .toc-list[data-dense] .toc-item::before,
    .toc-desktop .toc-list[data-dense] .toc-item::after {
      inset-block-start: 0.42rem;
    }

    .toc-rail-track {
      position: absolute;
      z-index: 0;
      inset-block: 0.15rem 0.25rem;
      inset-inline-end: 0.87rem;
      width: 1px;
      background-color: color-mix(in oklab, var(--foreground) 22%, transparent);
    }

    .toc-rail-window {
      position: absolute;
      inset-block-start: 0;
      inset-inline-start: -0.5px;
      display: block;
      width: 2px;
      height: var(--toc-window-height, 10px);
      background-color: color-mix(in oklab, var(--foreground) 68%, transparent);
      transform: translate3d(0, var(--toc-window-top, 0), 0);
      will-change: height, transform;
    }

    .toc-rail-window[hidden] {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-chevron,
    .toc-link,
    .toc-desktop-header {
      transition: none;
    }
  }
</style>

<script>
  const toc = document.getElementById('page-toc')

  if (toc) {
    const article = document.querySelector<HTMLElement>('article.prose')
    const headings = Array.from(
      document.querySelectorAll<HTMLElement>(
        'article.prose h2, article.prose h3, article.prose h4, article.prose h5, article.prose h6',
      ),
    )
    const textLinks = Array.from(
      toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'),
    )
    const desktopItems = Array.from(
      toc.querySelectorAll<HTMLElement>('.toc-desktop [data-toc-item]'),
    )
    const outlineList =
      toc.querySelector<HTMLUListElement>('[data-toc-outline]')
    const leadingSpacer = toc.querySelector<HTMLElement>(
      '[data-toc-leading-spacer]',
    )
    const railTrack = toc.querySelector<HTMLElement>('.toc-rail-track')
    const railWindow = toc.querySelector<HTMLElement>('.toc-rail-window')
    const topLink = toc.querySelector<HTMLAnchorElement>('[data-toc-top]')
    const current = toc.querySelector<HTMLElement>('[data-toc-current]')
    const mobileProgress = toc.querySelector<SVGCircleElement>(
      '.toc-progress-value',
    )
    const details = toc.querySelector<HTMLDetailsElement>('.toc-mobile')
    let frame = 0
    let needsMeasurement = true

    const clamp = (value: number, minimum: number, maximum: number) =>
      Math.min(maximum, Math.max(minimum, value))

    const copyHeadingContent = (target: HTMLElement, heading: HTMLElement) => {
      const copy = heading.cloneNode(true) as HTMLElement
      copy
        .querySelectorAll('[data-heading-anchor]')
        .forEach((anchor) => anchor.remove())
      target.replaceChildren(...Array.from(copy.childNodes))
    }

    const headingsById = new Map(
      headings.map((heading) => [heading.id, heading]),
    )
    for (const link of textLinks) {
      const heading = headingsById.get(link.dataset.headingId ?? '')
      if (heading) copyHeadingContent(link, heading)
    }

    const headerOffset = () => {
      const scrollPadding = Number.parseFloat(
        getComputedStyle(document.documentElement).scrollPaddingBlockStart,
      )
      const headerBottom =
        document.getElementById('site-header-shell')?.getBoundingClientRect()
          .bottom ?? 0
      return Math.max(scrollPadding || 0, headerBottom + 24)
    }

    const documentTop = (element: HTMLElement) =>
      element.getBoundingClientRect().top + scrollY

    const articleTop = () => (article ? documentTop(article) : 0)

    const updateSectionScales = () => {
      if (!article || !leadingSpacer) return

      const top = articleTop()
      const bottom = top + article.offsetHeight
      const firstHeading = headings[0]
      const leadingHeight = firstHeading
        ? Math.max(0, documentTop(firstHeading) - top)
        : 0

      leadingSpacer.hidden = leadingHeight <= 50
      leadingSpacer.style.setProperty(
        '--toc-leading-scale',
        String(leadingHeight),
      )

      for (let index = 0; index < desktopItems.length; index += 1) {
        const item = desktopItems[index]
        const heading = headings[index]
        const nextHeading = headings[index + 1]
        if (!heading) continue

        const start = documentTop(heading)
        const end = nextHeading ? documentTop(nextHeading) : bottom
        item.style.setProperty(
          '--toc-section-scale',
          String(Math.max(1, end - start)),
        )
      }
    }

    const measureOutline = () => {
      needsMeasurement = false
      if (!outlineList) return

      updateSectionScales()

      outlineList.removeAttribute('data-dense')
      const overflows = outlineList.scrollHeight > outlineList.clientHeight + 1
      outlineList.toggleAttribute('data-dense', overflows)
    }

    const updateViewportWindow = (offset: number) => {
      if (!article || !railTrack || !railWindow) return

      const trackHeight = railTrack.clientHeight
      const top = articleTop()
      const height = Math.max(1, article.offsetHeight)
      const viewportTop = scrollY + offset
      const viewportBottom = scrollY + innerHeight
      const visibleStart = clamp(viewportTop - top, 0, height)
      const visibleEnd = clamp(viewportBottom - top, 0, height)

      if (trackHeight <= 0 || visibleEnd <= visibleStart) {
        railWindow.hidden = true
        return
      }

      const windowHeight = Math.min(
        trackHeight,
        Math.max(10, ((visibleEnd - visibleStart) / height) * trackHeight),
      )
      const mappedTop = (visibleStart / height) * trackHeight
      const windowTop = clamp(mappedTop, 0, trackHeight - windowHeight)

      railWindow.hidden = false
      railWindow.style.setProperty('--toc-window-height', `${windowHeight}px`)
      railWindow.style.setProperty('--toc-window-top', `${windowTop}px`)
    }

    const update = () => {
      frame = 0
      const offset = headerOffset()
      const marker = scrollY + offset
      let active: HTMLElement | undefined

      for (const heading of headings) {
        if (documentTop(heading) > marker) break
        active = heading
      }

      for (const link of textLinks) {
        if (link.dataset.headingId === active?.id) {
          link.setAttribute('aria-current', 'location')
        } else {
          link.removeAttribute('aria-current')
        }
      }

      if (topLink) {
        if (active) topLink.removeAttribute('aria-current')
        else topLink.setAttribute('aria-current', 'location')
      }

      if (current) {
        if (active) copyHeadingContent(current, active)
        else current.textContent = 'Overview'
      }

      let ratio = 0
      if (article) {
        const visibleHeight = Math.max(0, innerHeight - offset)
        const distance = Math.max(1, article.offsetHeight - visibleHeight)
        ratio = clamp((marker - articleTop()) / distance, 0, 1)
      }

      if (needsMeasurement) measureOutline()
      updateViewportWindow(offset)

      if (mobileProgress) {
        mobileProgress.style.strokeDashoffset = String(62.832 * (1 - ratio))
      }
    }

    const scheduleUpdate = () => {
      if (!frame) frame = requestAnimationFrame(update)
    }

    for (const link of textLinks) {
      link.addEventListener('click', () => {
        if (details) details.open = false
      })
    }

    addEventListener('scroll', scheduleUpdate, { passive: true })
    addEventListener(
      'resize',
      () => {
        needsMeasurement = true
        scheduleUpdate()
      },
      { passive: true },
    )
    if (article && 'ResizeObserver' in window) {
      new ResizeObserver(() => {
        needsMeasurement = true
        scheduleUpdate()
      }).observe(article)
    }
    document.fonts?.ready.then(() => {
      needsMeasurement = true
      scheduleUpdate()
    })
    update()
  }
</script>
